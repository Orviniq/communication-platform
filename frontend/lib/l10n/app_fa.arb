  "sustainedChannelName": "\u0627\u062c\u0631\u0627 \u062f\u0631 \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647",
  "sustainedChannelDescription": "\u062a\u0627 \u0648\u0642\u062a\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0631\u0627\u06cc \u062f\u0631\u06cc\u0627\u0641\u062a \u067e\u06cc\u0627\u0645 \u0628\u0627\u0632 \u0646\u06af\u0647 \u062f\u0627\u0634\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.",
  "settingsSustainedTitle": "\u062f\u0631\u06cc\u0627\u0641\u062a \u0647\u0646\u06af\u0627\u0645 \u0628\u0633\u062a\u0647 \u0628\u0648\u062f\u0646",
  "settingsSustainedOff": "\u062e\u0627\u0645\u0648\u0634. \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0632\u0645\u0627\u0646\u200c\u0628\u0646\u062f\u06cc \u062e\u0648\u062f\u0634 \u062f\u0646\u0628\u0627\u0644 \u067e\u06cc\u0627\u0645 \u0645\u06cc\u200c\u06af\u0631\u062f\u062f\u061b \u06a9\u0646\u062f \u0627\u0633\u062a \u0648 \u0628\u0627\u0631\u0647\u0627 \u0627\u0635\u0644\u0627\u064b \u0627\u0646\u062c\u0627\u0645 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f.",
  "settingsSustainedHolding": "\u0631\u0648\u0634\u0646. \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0631 \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0628\u0627\u0632 \u0646\u06af\u0647 \u062f\u0627\u0634\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062a\u0627 \u0648\u0642\u062a\u06cc \u0631\u0648\u0634\u0646 \u0627\u0633\u062a \u06cc\u06a9 \u0627\u0639\u0644\u0627\u0646 \u062f\u0627\u0626\u0645\u06cc \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u062f\u06cc\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.",
  "settingsSustainedAlertsWithheld": "\u0631\u0648\u0634\u0646\u060c \u0627\u0645\u0627 \u0627\u0639\u0644\u0627\u0646\u200c\u0647\u0627 \u062e\u0627\u0645\u0648\u0634\u200c\u0627\u0646\u062f\u061b \u067e\u0633 \u0647\u06cc\u0686 \u0686\u06cc\u0632 \u0631\u0633\u06cc\u062f\u0646 \u067e\u06cc\u0627\u0645 \u0631\u0627 \u0628\u0647 \u0634\u0645\u0627 \u0646\u0645\u06cc\u200c\u06af\u0648\u06cc\u062f.",
  "settingsSustainedExemptionWithdrawn": "\u0631\u0648\u0634\u0646\u060c \u0627\u0645\u0627 \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0627\u062c\u0627\u0632\u0647\u0654 \u06a9\u0627\u0631 \u062f\u0631 \u062d\u0627\u0644\u062a \u0630\u062e\u06cc\u0631\u0647\u0654 \u0628\u0627\u062a\u0631\u06cc \u0631\u0627 \u067e\u0633 \u06af\u0631\u0641\u062a\u0647 \u0627\u0633\u062a.",
  "settingsSustainedStopped": "\u0631\u0648\u0634\u0646\u060c \u0627\u0645\u0627 \u0647\u0645\u06cc\u0646 \u062d\u0627\u0644\u0627 \u062f\u0631 \u062d\u0627\u0644 \u0627\u062c\u0631\u0627 \u0646\u06cc\u0633\u062a.",
  "settingsSustainedUnavailable": "\u062f\u0631 \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a.",
  "settingsSustainedWithheld": "\u062f\u0631 \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u0627\u0631\u0627\u0626\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0647\u0646\u0648\u0632 \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc\u200c\u0647\u0627\u06cc\u06cc \u0645\u062b\u0644 \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0622\u0632\u0645\u0627\u06cc\u0634 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a.",
  "sustainedTitle": "\u062f\u0631\u06cc\u0627\u0641\u062a \u0647\u0646\u06af\u0627\u0645 \u0628\u0633\u062a\u0647 \u0628\u0648\u062f\u0646",
  "sustainedWhatItDoes": "\u0628\u0647\u200c\u0637\u0648\u0631 \u0645\u0639\u0645\u0648\u0644 \u0648\u0642\u062a\u06cc \u0627\u0632 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u06cc\u0631\u0648\u0646 \u0645\u06cc\u200c\u0631\u0648\u06cc\u062f \u06af\u0648\u0634\u06cc \u0622\u0646 \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u062f\u0633\u062a\u200c\u0628\u0627\u0644\u0627 \u0647\u0631 \u067e\u0627\u0646\u0632\u062f\u0647 \u062f\u0642\u06cc\u0642\u0647 \u0627\u062c\u0627\u0632\u0647 \u0645\u06cc\u200c\u062f\u0647\u062f \u062f\u0646\u0628\u0627\u0644 \u067e\u06cc\u0627\u0645 \u062a\u0627\u0632\u0647 \u0628\u06af\u0631\u062f\u062f. \u0628\u0627 \u0631\u0648\u0634\u0646 \u06a9\u0631\u062f\u0646 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647\u060c \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0631 \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0628\u0627\u0632 \u0646\u06af\u0647 \u062f\u0627\u0634\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u062a\u0627 \u067e\u06cc\u0627\u0645 \u0628\u062f\u0648\u0646 \u0627\u0646\u062a\u0638\u0627\u0631 \u0628\u0631\u0627\u06cc \u0622\u0646 \u0628\u0627\u0632\u0647 \u0628\u0647 \u0634\u0645\u0627 \u0628\u0631\u0633\u062f. \u0627\u06cc\u0646\u06a9\u0647 \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0686\u0642\u062f\u0631 \u0637\u0648\u0644 \u0645\u06cc\u200c\u06a9\u0634\u062f\u060c \u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u0646\u0634\u062f\u0647 \u0627\u0633\u062a.",
  "sustainedWhatItCosts": "\u0628\u0627\u062a\u0631\u06cc \u0628\u06cc\u0634\u062a\u0631\u06cc \u0645\u0635\u0631\u0641 \u0645\u06cc\u200c\u0634\u0648\u062f\u060c \u0686\u0648\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0645\u062a\u0635\u0644 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f. \u06cc\u06a9 \u0627\u0639\u0644\u0627\u0646 \u062f\u0627\u0626\u0645\u06cc \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0645\u06cc\u200c\u06af\u0630\u0627\u0631\u062f \u06a9\u0647 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0631 \u062d\u0627\u0644 \u0627\u062c\u0631\u0627\u0633\u062a: \u0647\u0631 \u06a9\u0633\u06cc \u06a9\u0647 \u0642\u0641\u0644 \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\u062f \u0648 \u0646\u06af\u0627\u0647 \u06a9\u0646\u062f \u0622\u0646 \u0631\u0627 \u0645\u06cc\u200c\u0628\u06cc\u0646\u062f \u0648 \u062a\u0627 \u0648\u0642\u062a\u06cc \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0631\u0627 \u062e\u0627\u0645\u0648\u0634 \u0646\u06a9\u0646\u06cc\u062f \u0622\u0646\u062c\u0627 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f. \u0631\u0648\u06cc \u0635\u0641\u062d\u0647\u0654 \u0642\u0641\u0644 \u067e\u0646\u0647\u0627\u0646 \u0627\u0633\u062a.",
  "sustainedWhatItCannotPromise": "\u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0627\u062c\u0627\u0632\u0647 \u062f\u0627\u0631\u062f \u0647\u0631 \u0644\u062d\u0638\u0647 \u0622\u0646 \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u06a9\u0646\u062f \u0648 \u0686\u06cc\u0632\u06cc \u0647\u0645 \u0646\u0645\u06cc\u200c\u06af\u0648\u06cc\u062f. \u0627\u06af\u0631 \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u0628\u0647\u200c\u0627\u062c\u0628\u0627\u0631 \u0645\u062a\u0648\u0642\u0641 \u06a9\u0646\u06cc\u062f (force stop) \u06cc\u0627 \u0645\u0635\u0631\u0641 \u0628\u0627\u062a\u0631\u06cc \u0622\u0646 \u0631\u0627 \u0645\u062d\u062f\u0648\u062f \u06a9\u0646\u06cc\u062f\u060c \u0628\u0647\u200c\u06a9\u0644\u06cc \u0645\u062a\u0648\u0642\u0641 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0642\u0648\u0644 \u0628\u062f\u0647\u062f \u06a9\u0647 \u06a9\u0627\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u0641\u0642\u0637 \u0642\u0648\u0644 \u0645\u06cc\u200c\u062f\u0647\u062f \u0647\u0631 \u0648\u0642\u062a \u0628\u0628\u06cc\u0646\u062f \u06a9\u0627\u0631 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0647\u0645\u06cc\u0646\u200c\u062c\u0627 \u0628\u0647 \u0634\u0645\u0627 \u0628\u06af\u0648\u06cc\u062f.",
  "sustainedNeedsTitle": "\u0622\u0646\u0686\u0647 \u06af\u0648\u0634\u06cc \u0627\u0632 \u0634\u0645\u0627 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u062f",
  "sustainedNeedsAlerts": "\u0627\u062c\u0627\u0632\u0647\u0654 \u0646\u0645\u0627\u06cc\u0634 \u0627\u0639\u0644\u0627\u0646. \u0628\u062f\u0648\u0646 \u0622\u0646 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u067e\u06cc\u0627\u0645\u06cc \u0628\u0631\u0633\u062f \u0648 \u0647\u06cc\u0686 \u0686\u06cc\u0632 \u0628\u0647 \u0634\u0645\u0627 \u0646\u06af\u0648\u06cc\u062f.",
  "sustainedNeedsExemption": "\u0627\u062c\u0627\u0632\u0647\u0654 \u0627\u062f\u0627\u0645\u0647\u0654 \u06a9\u0627\u0631 \u062f\u0631 \u062d\u0627\u0644\u062a\u06cc \u06a9\u0647 \u06af\u0648\u0634\u06cc \u0628\u0627\u062a\u0631\u06cc \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u06af\u0648\u0634\u06cc \u062e\u0648\u062f\u0634 \u0645\u0633\u062a\u0642\u06cc\u0645 \u0627\u0632 \u0634\u0645\u0627 \u0645\u06cc\u200c\u067e\u0631\u0633\u062f.",
  "sustainedNeedsVendor": "\u0631\u0648\u06cc \u06af\u0648\u0634\u06cc\u200c\u0647\u0627\u06cc \u0633\u0627\u0645\u0633\u0648\u0646\u06af \u0648 \u0634\u06cc\u0627\u0626\u0648\u0645\u06cc \u06cc\u06a9 \u06a9\u0627\u0631 \u062f\u06cc\u06af\u0631 \u0647\u0645 \u0644\u0627\u0632\u0645 \u0627\u0633\u062a: \u06af\u0648\u0634\u06cc \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627\u06cc \u06a9\u0645\u200c\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0631\u0627 \u062e\u0648\u062f\u0634 \u0628\u0647 \u062e\u0648\u0627\u0628 \u0645\u06cc\u200c\u0628\u0631\u062f \u0648 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0627\u06cc\u062f \u0627\u0632 \u0622\u0646 \u0645\u0633\u062a\u062b\u0646\u0627 \u0634\u0648\u062f. \u0641\u0642\u0637 \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0631\u0627 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f \u0648 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u062f \u06a9\u0647 \u0627\u0646\u062c\u0627\u0645\u0634 \u062f\u0627\u062f\u0647\u200c\u0627\u06cc\u062f \u06cc\u0627 \u0646\u0647.",
  "sustainedVendorAction": "\u0628\u0627\u0632 \u06a9\u0631\u062f\u0646 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u06af\u0648\u0634\u06cc \u0645\u0646",
  "sustainedTurnOn": "\u0631\u0648\u0634\u0646 \u06a9\u0631\u062f\u0646",
  "sustainedTurnOff": "\u062e\u0627\u0645\u0648\u0634 \u06a9\u0631\u062f\u0646",
  "sustainedStatusOff": "\u062e\u0627\u0645\u0648\u0634. \u0686\u06cc\u0632\u06cc \u062f\u0631 \u062d\u0627\u0644 \u0627\u062c\u0631\u0627 \u0646\u06cc\u0633\u062a \u0648 \u0686\u06cc\u0632\u06cc \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f.",
  "sustainedStatusHolding": "\u0631\u0648\u0634\u0646. \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0627\u0632 \u0646\u06af\u0647 \u062f\u0627\u0634\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.",
  "sustainedStatusAlertsWithheld": "\u0627\u0639\u0644\u0627\u0646\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u062e\u0627\u0645\u0648\u0634 \u0627\u0633\u062a\u060c \u067e\u0633 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0645\u062a\u0648\u0642\u0641 \u0634\u062f. \u0627\u0639\u0644\u0627\u0646\u200c\u0647\u0627 \u0631\u0627 \u0631\u0648\u0634\u0646 \u06a9\u0646\u06cc\u062f \u062a\u0627 \u062f\u0648\u0628\u0627\u0631\u0647 \u0634\u0631\u0648\u0639 \u0634\u0648\u062f.",
  "sustainedStatusExemptionWithdrawn": "\u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0627\u062c\u0627\u0632\u0647\u0654 \u06a9\u0627\u0631 \u062f\u0631 \u062d\u0627\u0644\u062a \u0630\u062e\u06cc\u0631\u0647\u0654 \u0628\u0627\u062a\u0631\u06cc \u0631\u0627 \u067e\u0633 \u06af\u0631\u0641\u062a\u0647 \u0627\u0633\u062a\u060c \u067e\u0633 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0645\u062a\u0648\u0642\u0641 \u0634\u062f. \u0627\u06cc\u0646 \u0627\u062a\u0641\u0627\u0642 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u067e\u0633 \u0627\u0632 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u06af\u0648\u0634\u06cc \u062e\u0648\u062f\u0628\u0647\u200c\u062e\u0648\u062f \u0628\u06cc\u0641\u062a\u062f. \u062f\u0648\u0628\u0627\u0631\u0647 \u0631\u0648\u0634\u0646 \u06a9\u0646\u06cc\u062f \u062a\u0627 \u0627\u062c\u0627\u0632\u0647 \u06cc\u06a9 \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u062e\u0648\u0627\u0633\u062a\u0647 \u0634\u0648\u062f.",
  "sustainedStatusStopped": "\u062f\u0631 \u0627\u06cc\u0646 \u0644\u062d\u0638\u0647 \u062f\u0631 \u062d\u0627\u0644 \u0627\u062c\u0631\u0627 \u0646\u06cc\u0633\u062a. \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0622\u0646 \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u06a9\u0631\u062f\u0647 \u0628\u0627\u0634\u062f.",
  "sustainedStatusUnavailable": "\u062f\u0631 \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a.",
  "sustainedStatusWithheld": "\u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0631\u0627 \u0631\u0648\u0634\u0646 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f. \u06a9\u0627\u0631\u06cc \u06a9\u0647 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u062f\u0647\u062f \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc\u200c\u0647\u0627\u06cc\u06cc \u0645\u062b\u0644 \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u0646\u0634\u062f\u0647 \u0627\u0633\u062a\u060c \u0648 \u0627\u0631\u0627\u0626\u0647\u0654 \u0622\u0646 \u067e\u06cc\u0634 \u0627\u0632 \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u06cc\u0639\u0646\u06cc \u0642\u0648\u0644 \u062f\u0627\u062f\u0646 \u0686\u06cc\u0632\u06cc \u06a9\u0647 \u06a9\u0633\u06cc \u0628\u0631\u0631\u0633\u06cc\u200c\u0627\u0634 \u0646\u06a9\u0631\u062f\u0647 \u0627\u0633\u062a. \u0686\u06cc\u0632\u06cc \u062f\u0631 \u062d\u0627\u0644 \u0627\u062c\u0631\u0627 \u0646\u06cc\u0633\u062a \u0648 \u0686\u06cc\u0632\u06cc \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f.",
  "sustainedRefusedAlerts": "\u0631\u0648\u0634\u0646 \u0646\u0634\u062f: \u0627\u0639\u0644\u0627\u0646\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0647\u0646\u0648\u0632 \u062e\u0627\u0645\u0648\u0634 \u0627\u0633\u062a.",
  "sustainedRefusedExemption": "\u0631\u0648\u0634\u0646 \u0646\u0634\u062f: \u06af\u0648\u0634\u06cc \u0627\u062c\u0627\u0632\u0647\u0654 \u06a9\u0627\u0631 \u062f\u0631 \u062d\u0627\u0644\u062a \u0630\u062e\u06cc\u0631\u0647\u0654 \u0628\u0627\u062a\u0631\u06cc \u0631\u0627 \u0646\u062f\u0627\u062f.",
  "sustainedRefusedPlatform": "\u0631\u0648\u0634\u0646 \u0646\u0634\u062f: \u06af\u0648\u0634\u06cc \u0627\u062c\u0627\u0632\u0647 \u0646\u062f\u0627\u062f \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0631 \u062d\u0627\u0644 \u0627\u062c\u0631\u0627 \u0628\u0645\u0627\u0646\u062f. \u0628\u0631\u062e\u06cc \u06af\u0648\u0634\u06cc\u200c\u0647\u0627 \u062a\u0627 \u0648\u0642\u062a\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0632 \u0641\u0647\u0631\u0633\u062a \u00ab\u0628\u0647 \u062e\u0648\u0627\u0628 \u0628\u0631\u062f\u0646 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627\u00bb \u0645\u0633\u062a\u062b\u0646\u0627 \u0646\u0634\u0648\u062f \u0647\u0645\u06cc\u0646 \u06a9\u0627\u0631 \u0631\u0627 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f.",
  "sustainedRefusedNotRecorded": "\u0631\u0648\u0634\u0646 \u0646\u0634\u062f: \u0627\u06cc\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u0631\u0648\u06cc \u0627\u06cc\u0646 \u06af\u0648\u0634\u06cc \u0630\u062e\u06cc\u0631\u0647 \u0646\u0634\u062f \u0648 \u067e\u0633 \u0627\u0632 \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u0645\u062c\u062f\u062f \u0628\u0627\u0642\u06cc \u0646\u0645\u06cc\u200c\u0645\u0627\u0646\u062f.",
  "sustainedRefusedUnavailable": "\u062f\u0631 \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u06cc\u0633\u062a.",
  "sustainedRefusedWithheld": "\u0631\u0648\u0634\u0646 \u0646\u0634\u062f: \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u0647\u0646\u0648\u0632 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0631\u0627 \u0627\u0631\u0627\u0626\u0647 \u0646\u0645\u06cc\u200c\u062f\u0647\u062f.",
  "settingsSignedInAs": "\u0648\u0627\u0631\u062f\u200c\u0634\u062f\u0647 \u0628\u0627 {username}",
  "settingsProfileSummary": "\u0646\u0627\u0645 \u0646\u0645\u0627\u06cc\u0634\u06cc \u0648 \u0639\u06a9\u0633 \u0634\u0645\u0627\u060c \u0648 \u0622\u0646\u0686\u0647 \u062f\u06cc\u06af\u0631\u0627\u0646 \u0645\u06cc\u200c\u0628\u06cc\u0646\u0646\u062f",
  "settingsSavedMessagesSummary": "\u06cc\u0627\u062f\u062f\u0627\u0634\u062a\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc\u060c \u0630\u062e\u06cc\u0631\u0647\u200c\u0634\u062f\u0647 \u0631\u0648\u06cc \u0647\u0645\u06cc\u0646 \u06af\u0648\u0634\u06cc",
  "settingsSecurityTitle": "\u0627\u0645\u0646\u06cc\u062a \u0648 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc",
