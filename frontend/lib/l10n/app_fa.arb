  "settingsEraseAccountSummary": "\u0647\u0631 \u0686\u0647 \u0633\u0631\u0648\u0631 \u062f\u0631\u0628\u0627\u0631\u0647\u0654 \u0627\u06cc\u0646 \u062d\u0633\u0627\u0628 \u0646\u06af\u0647 \u0645\u06cc\u200c\u062f\u0627\u0631\u062f \u062d\u0630\u0641 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0628\u0631\u06af\u0634\u062a\u200c\u067e\u0630\u06cc\u0631 \u0646\u06cc\u0633\u062a.",
  "eraseAccountConfirmTitle": "\u0627\u06cc\u0646 \u062d\u0633\u0627\u0628 \u067e\u0627\u06a9 \u0634\u0648\u062f\u061f",
  "eraseAccountServerScope": "\u0647\u0631 \u0686\u0647 \u0633\u0631\u0648\u0631 \u062f\u0631\u0628\u0627\u0631\u0647\u0654 \u0627\u06cc\u0646 \u062d\u0633\u0627\u0628 \u0646\u06af\u0647 \u0645\u06cc\u200c\u062f\u0627\u0631\u062f \u062d\u0630\u0641 \u0645\u06cc\u200c\u0634\u0648\u062f: \u062f\u0633\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u0634\u0645\u0627\u060c \u06a9\u0644\u06cc\u062f\u0647\u0627\u06cc\u062a\u0627\u0646\u060c \u0647\u0648\u06cc\u062a \u0645\u0646\u062a\u0634\u0631\u0634\u062f\u0647\u200c\u062a\u0627\u0646\u060c \u0646\u0645\u0627\u06cc\u0647\u200c\u062a\u0627\u0646\u060c \u0648 \u0647\u0631 \u067e\u06cc\u0627\u0645\u06cc \u06a9\u0647 \u0647\u0646\u0648\u0632 \u0645\u0646\u062a\u0638\u0631 \u0631\u0633\u06cc\u062f\u0646 \u0628\u0647 \u0634\u0645\u0627\u0633\u062a.",
  "eraseAccountPeerCopies": "\u0646\u0633\u062e\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u062f\u06cc\u06af\u0631\u0627\u0646 \u062f\u0627\u0631\u0646\u062f \u067e\u0627\u06a9 \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0647\u0631 \u067e\u06cc\u0627\u0645\u06cc \u06a9\u0647 \u0641\u0631\u0633\u062a\u0627\u062f\u0647\u200c\u0627\u06cc\u062f \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u06af\u06cc\u0631\u0646\u062f\u0647 \u0631\u0645\u0632\u06af\u0634\u0627\u06cc\u06cc \u0634\u062f\u0647 \u0648 \u0647\u0645\u0627\u0646\u200c\u062c\u0627 \u0630\u062e\u06cc\u0631\u0647 \u0627\u0633\u062a. \u0647\u06cc\u0686 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0628\u0647 \u062f\u0633\u062a\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631\u06cc \u0646\u0645\u06cc\u200c\u0631\u0633\u062f.",
  "eraseAccountAttachments": "\u0641\u0627\u06cc\u0644\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f \u062a\u0627 {days} \u0631\u0648\u0632 \u0631\u0648\u06cc \u0633\u0631\u0648\u0631 \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f\u060c \u062a\u0627 \u0648\u0642\u062a\u06cc \u0628\u0627\u0632\u0647\u0654 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u062a\u0645\u0627\u0645 \u0634\u0648\u062f. \u0647\u06cc\u0686 \u0686\u06cc\u0632\u0650 \u0630\u062e\u06cc\u0631\u0647\u200c\u0634\u062f\u0647 \u06a9\u0646\u0627\u0631 \u06cc\u06a9 \u0641\u0627\u06cc\u0644 \u0646\u0627\u0645 \u062d\u0633\u0627\u0628 \u0634\u0645\u0627 \u0631\u0627 \u0646\u062f\u0627\u0631\u062f\u060c \u067e\u0633 \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u0627\u0632 \u0622\u0646\u200c\u0647\u0627 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f \u06a9\u0647 \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0628\u062a\u0648\u0627\u0646\u062f \u062d\u0630\u0641\u0634 \u06a9\u0646\u062f.",
  "eraseAccountUsernameFreed": "\u0646\u0627\u0645 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0634\u0645\u0627 \u0628\u06cc\u200c\u062f\u0631\u0646\u06af \u0622\u0632\u0627\u062f \u0645\u06cc\u200c\u0634\u0648\u062f. \u0634\u062e\u0635 \u062f\u06cc\u06af\u0631\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0622\u0646 \u0631\u0627 \u062b\u0628\u062a \u06a9\u0646\u062f.",
  "eraseAccountPasswordLabel": "\u06af\u0630\u0631\u0648\u0627\u0698\u0647\u0654 \u0634\u0645\u0627",
  "eraseAccountPasswordPurpose": "\u06af\u0630\u0631\u0648\u0627\u0698\u0647 \u0641\u0642\u0637 \u0628\u0627 \u0647\u0645\u06cc\u0646 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0641\u0631\u0633\u062a\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0647\u06cc\u0686\u200c\u062c\u0627 \u0630\u062e\u06cc\u0631\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f.",
  "eraseAccountAction": "\u067e\u0627\u06a9\u200c\u0633\u0627\u0632\u06cc \u062d\u0633\u0627\u0628",
  "eraseAccountWorkingAction": "\u062f\u0631 \u062d\u0627\u0644 \u067e\u0627\u06a9\u200c\u0633\u0627\u0632\u06cc\u2026",
  "eraseAccountWrongPassword": "\u06af\u0630\u0631\u0648\u0627\u0698\u0647 \u0646\u0627\u062f\u0631\u0633\u062a \u0627\u0633\u062a. {used} \u062a\u0644\u0627\u0634 \u0627\u0632 {allowed} \u062a\u0644\u0627\u0634 \u0645\u0635\u0631\u0641 \u0634\u062f. \u067e\u0633 \u0627\u0632 {allowed} \u062a\u0644\u0627\u0634 \u0646\u0627\u062f\u0631\u0633\u062a\u060c \u0627\u06cc\u0646 \u0646\u0627\u0645 \u06a9\u0627\u0631\u0628\u0631\u06cc \u067e\u0627\u0646\u0632\u062f\u0647 \u062f\u0642\u06cc\u0642\u0647 \u0642\u0641\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f \u2014 \u0647\u0645 \u0627\u06cc\u0646\u062c\u0627 \u0648 \u0647\u0645 \u062f\u0631 \u0635\u0641\u062d\u0647\u0654 \u0648\u0631\u0648\u062f\u060c \u0631\u0648\u06cc \u0647\u0645\u0647\u0654 \u062f\u0633\u062a\u06af\u0627\u0647\u200c\u0647\u0627.",
  "eraseAccountThrottled": "\u062a\u0644\u0627\u0634 \u0628\u06cc\u0634 \u0627\u0632 \u062d\u062f. {wait} \u062f\u06cc\u06af\u0631 \u062f\u0648\u0628\u0627\u0631\u0647 \u062a\u0644\u0627\u0634 \u06a9\u0646\u06cc\u062f.",
  "eraseAccountThrottledUnknownWait": "\u062a\u0644\u0627\u0634 \u0628\u06cc\u0634 \u0627\u0632 \u062d\u062f. \u0628\u0639\u062f\u0627\u064b \u062f\u0648\u0628\u0627\u0631\u0647 \u062a\u0644\u0627\u0634 \u06a9\u0646\u06cc\u062f.",
  "eraseAccountWaitMinutes": "{minutes} \u062f\u0642\u06cc\u0642\u0647",
  "eraseAccountWaitSeconds": "{seconds} \u062b\u0627\u0646\u06cc\u0647",
  "appearanceTitle": "\u0638\u0627\u0647\u0631",
  "appearanceLocalOnlyNotice": "\u0627\u06cc\u0646 \u062f\u0648 \u062a\u0646\u0638\u06cc\u0645 \u0631\u0648\u06cc \u0647\u0645\u06cc\u0646 \u06af\u0648\u0634\u06cc \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f. \u062c\u0627\u06cc\u06cc \u0641\u0631\u0633\u062a\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f \u0648 \u06a9\u0633\u06cc \u062f\u06cc\u06af\u0631 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0646\u0645\u06cc\u200c\u0628\u06cc\u0646\u062f.",
  "appearanceThemeSection": "\u067e\u0648\u0633\u062a\u0647",
