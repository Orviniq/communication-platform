  "appearanceThemeLight": "\u0631\u0648\u0634\u0646",
  "appearanceThemeDark": "\u062a\u06cc\u0631\u0647",
  "appearanceContrastNotice": "\u06a9\u0646\u062a\u0631\u0627\u0633\u062a \u0628\u0627\u0644\u0627 \u0627\u0632 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062f\u0633\u062a\u0631\u0633\u200c\u067e\u0630\u06cc\u0631\u06cc \u06af\u0648\u0634\u06cc \u067e\u06cc\u0631\u0648\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u06a9\u0644\u06cc\u062f\u06cc \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0646\u062f\u0627\u0631\u062f.",
  "appearanceLanguageSection": "\u0632\u0628\u0627\u0646",
  "appearanceLanguageSystem": "\u0645\u0637\u0627\u0628\u0642 \u06af\u0648\u0634\u06cc",
  "appearanceLanguageEnglish": "English",
  "appearanceLanguagePersian": "\u0641\u0627\u0631\u0633\u06cc",
  "appearanceNotStoredNotice": "\u0627\u06cc\u0646 \u06af\u0648\u0634\u06cc \u0646\u062a\u0648\u0627\u0646\u0633\u062a \u0627\u06cc\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u0631\u0627 \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0646\u062f. \u0647\u0645\u06cc\u0646 \u062d\u0627\u0644\u0627 \u0627\u0639\u0645\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0628\u0627 \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u062f\u0648\u0628\u0627\u0631\u0647\u0654 \u0628\u0631\u0646\u0627\u0645\u0647 \u062f\u0648\u0628\u0627\u0631\u0647 \u0627\u0632 \u06af\u0648\u0634\u06cc \u067e\u06cc\u0631\u0648\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f.",
  "securitySettingsTitle": "\u0627\u0645\u0646\u06cc\u062a \u0648 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc",
  "securityRecoveryTitle": "\u0631\u0645\u0632 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc",
  "securityRecoveryBody": "\u0631\u0645\u0632 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0641\u0642\u0637 \u06cc\u06a9 \u0628\u0627\u0631\u060c \u0647\u0646\u06af\u0627\u0645 \u0633\u0627\u062e\u062a\u0647 \u0634\u062f\u0646\u060c \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0647\u0631\u06af\u0632 \u0646\u0633\u062e\u0647\u200c\u0627\u06cc \u0627\u0632 \u0622\u0646 \u0646\u06af\u0647 \u0646\u0645\u06cc\u200c\u062f\u0627\u0631\u062f \u2014 \u067e\u0633 \u062f\u0648\u0628\u0627\u0631\u0647 \u0642\u0627\u0628\u0644 \u0646\u0645\u0627\u06cc\u0634 \u0646\u06cc\u0633\u062a. \u0627\u06af\u0631 \u0631\u0645\u0632 \u062e\u0648\u062f \u0631\u0627 \u06af\u0645 \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f \u06cc\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u06a9\u0633 \u062f\u06cc\u06af\u0631\u06cc \u0622\u0646 \u0631\u0627 \u062f\u06cc\u062f\u0647 \u0628\u0627\u0634\u062f\u060c \u0627\u06cc\u0646\u062c\u0627 \u06cc\u06a9\u06cc \u062a\u0627\u0632\u0647 \u0628\u0633\u0627\u0632\u06cc\u062f. \u0633\u0631\u0648\u0631 \u0641\u0642\u0637 \u06cc\u06a9 \u0646\u0633\u062e\u0647\u0654 \u063a\u06cc\u0631\u0642\u0627\u0628\u0644\u200c\u062e\u0648\u0627\u0646\u062f\u0646 \u0627\u0632 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0631\u0627 \u0646\u06af\u0647 \u0645\u06cc\u200c\u062f\u0627\u0631\u062f\u060c \u0647\u0631\u06af\u0632 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u0634\u0645\u0627 \u0631\u0627.",
  "securityRecoveryAction": "\u0633\u0627\u062e\u062a \u0631\u0645\u0632 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u062a\u0627\u0632\u0647",
  "securitySafetyNumbersTitle": "\u0634\u0645\u0627\u0631\u0647\u200c\u0647\u0627\u06cc \u0627\u06cc\u0645\u0646\u06cc",
  "securitySafetyNumbersSummary": "\u06a9\u062f\u0627\u0645 \u0645\u062e\u0627\u0637\u0628\u0627\u0646 \u0631\u0627 \u062d\u0636\u0648\u0631\u06cc \u0628\u0631\u0631\u0633\u06cc \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f \u0648 \u06a9\u062f\u0627\u0645 \u0631\u0627 \u0646\u0647",
  "safetyNumbersReviewBody": "\u0628\u0631\u0627\u06cc \u0645\u0642\u0627\u06cc\u0633\u0647\u0654 \u0634\u0645\u0627\u0631\u0647\u0654 \u0627\u06cc\u0645\u0646\u06cc \u062d\u0636\u0648\u0631\u06cc \u06cc\u0627 \u0627\u0632 \u0631\u0627\u0647\u06cc \u06a9\u0647 \u0628\u0647 \u0622\u0646 \u0627\u0639\u062a\u0645\u0627\u062f \u062f\u0627\u0631\u06cc\u062f\u060c \u0645\u062e\u0627\u0637\u0628 \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f. \u062a\u0627 \u0622\u0646 \u0632\u0645\u0627\u0646\u060c \u067e\u06cc\u0627\u0645\u200c\u0631\u0633\u0627\u0646\u06cc \u0628\u0627 \u0627\u0648 \u0645\u062a\u0648\u0642\u0641 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f.",
  "recoveryRotationTitle": "\u0631\u0645\u0632 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u062a\u0627\u0632\u0647",
  "recoveryRotationExplain": "\u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0628\u0631\u0627\u06cc \u0647\u0645\u0627\u0646 \u0647\u0648\u06cc\u062a\u06cc \u06a9\u0647 \u062f\u0627\u0631\u06cc\u062f \u0631\u0645\u0632\u06cc \u062a\u0627\u0632\u0647 \u0645\u06cc\u200c\u0633\u0627\u0632\u062f. \u0645\u062e\u0627\u0637\u0628\u0627\u0646 \u0634\u0645\u0627 \u062a\u0623\u06cc\u06cc\u062f\u200c\u0634\u062f\u0647 \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f \u0648 \u062f\u0633\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u062f\u06cc\u06af\u0631\u062a\u0627\u0646 \u0645\u062a\u0635\u0644 \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f \u2014 \u062a\u0646\u0647\u0627 \u0631\u0645\u0632\u06cc \u06a9\u0647 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0631\u0627 \u0628\u0627\u0632 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0639\u0648\u0636 \u0645\u06cc\u200c\u0634\u0648\u062f.",
  "recoveryRotationCost": "\u0631\u0645\u0632\u06cc \u06a9\u0647 \u0627\u06a9\u0646\u0648\u0646 \u062f\u0627\u0631\u06cc\u062f \u0628\u0647 \u0645\u062d\u0636 \u0633\u0627\u062e\u062a\u0647 \u0634\u062f\u0646 \u0631\u0645\u0632 \u062a\u0627\u0632\u0647 \u0627\u0632 \u06a9\u0627\u0631 \u0645\u06cc\u200c\u0627\u0641\u062a\u062f. \u067e\u06cc\u0634 \u0627\u0632 \u062e\u0631\u0648\u062c \u0627\u0632 \u0627\u06cc\u0646 \u0635\u0641\u062d\u0647 \u0631\u0645\u0632 \u062a\u0627\u0632\u0647 \u0631\u0627 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u06a9\u0646\u06cc\u062f: \u0641\u0642\u0637 \u06cc\u06a9 \u0628\u0627\u0631 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u0633\u062e\u0647\u200c\u0627\u06cc \u0627\u0632 \u0622\u0646 \u0646\u06af\u0647 \u0646\u0645\u06cc\u200c\u062f\u0627\u0631\u062f.",
