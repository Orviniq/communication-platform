  "linkedDevicesRemoveSelfTitle": "\u062f\u0633\u062a\u06af\u0627\u0647\u06cc \u06a9\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f \u062d\u0630\u0641 \u0634\u0648\u062f\u061f",
  "linkedDevicesRemoveBody": "\u0622\u0646 \u062f\u0633\u062a\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u062a\u0627\u0632\u0647 \u0631\u0627 \u0628\u062e\u0648\u0627\u0646\u062f \u0648 \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0628\u0627\u0632\u06af\u0634\u062a\u200c\u067e\u0630\u06cc\u0631 \u0646\u06cc\u0633\u062a. \u0647\u0631 \u0686\u0647 \u0631\u0648\u06cc \u0622\u0646 \u0627\u0633\u062a \u062a\u0627 \u0632\u0645\u0627\u0646 \u062e\u0631\u0648\u062c \u06cc\u0627 \u067e\u0627\u06a9\u200c\u0633\u0627\u0632\u06cc \u0647\u0645\u0627\u0646\u062c\u0627 \u0645\u06cc\u200c\u0645\u0627\u0646\u062f.",
  "linkedDevicesRemoveSelfBody": "\u0627\u06cc\u0646 \u06af\u0648\u0634\u06cc \u0627\u0632 \u062d\u0633\u0627\u0628 \u062e\u0627\u0631\u062c \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0647\u0631 \u0686\u0647 \u0631\u0648\u06cc \u0622\u0646 \u0627\u0633\u062a \u067e\u0627\u06a9 \u0645\u06cc\u200c\u0634\u0648\u062f\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627 \u0648 \u06a9\u0644\u06cc\u062f\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0631\u0645\u0632\u06af\u0634\u0627\u06cc\u06cc \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f. \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0628\u0627\u0632\u06af\u0634\u062a\u200c\u067e\u0630\u06cc\u0631 \u0646\u06cc\u0633\u062a.",
  "linkedDevicesAddTitle": "\u0627\u0641\u0632\u0648\u062f\u0646 \u062f\u0633\u062a\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631",
  "linkedDevicesAddBody": "\u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u0631\u0648\u06cc \u062f\u0633\u062a\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631 \u0646\u0635\u0628 \u06a9\u0646\u06cc\u062f\u060c \u0647\u0645\u0627\u0646\u062c\u0627 \u0648\u0627\u0631\u062f \u0634\u0648\u06cc\u062f \u0648 \u0648\u0642\u062a\u06cc \u067e\u0631\u0633\u06cc\u062f\u060c \u0631\u0645\u0632 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u062e\u0648\u062f \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f. \u067e\u0633 \u0627\u0632 \u0627\u0645\u0636\u0627 \u0634\u062f\u0646\u060c \u062f\u0631 \u0627\u06cc\u0646 \u0641\u0647\u0631\u0633\u062a \u062f\u06cc\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u067e\u0633 \u0627\u0632 \u0622\u0646 \u0627\u06cc\u0646 \u06af\u0648\u0634\u06cc \u0631\u0627 \u0645\u062a\u0635\u0644 \u0646\u06af\u0647 \u062f\u0627\u0631\u06cc\u062f \u062a\u0627 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u0631\u0627 \u0628\u0641\u0631\u0633\u062a\u062f\u061b \u0633\u0631\u0648\u0631 \u0646\u0633\u062e\u0647\u200c\u0627\u06cc \u0628\u0631\u0627\u06cc \u0641\u0631\u0633\u062a\u0627\u062f\u0646 \u0646\u062f\u0627\u0631\u062f."
}
