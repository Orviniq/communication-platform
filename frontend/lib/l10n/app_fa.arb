  "settingsAppearanceSummary": "\u067e\u0648\u0633\u062a\u0647 \u0648 \u0632\u0628\u0627\u0646\u060c \u0641\u0642\u0637 \u0631\u0648\u06cc \u0647\u0645\u06cc\u0646 \u06af\u0648\u0634\u06cc",
  "settingsAboutTitle": "\u062f\u0631\u0628\u0627\u0631\u0647",
  "settingsAboutSummary": "\u0646\u0633\u062e\u0647\u060c \u0645\u0627\u0647\u06cc\u062a \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647\u060c \u0648 \u06af\u0632\u0627\u0631\u0634\u06cc \u06a9\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u06a9\u067e\u06cc \u06a9\u0646\u06cc\u062f",
  "settingsLogOutTitle": "\u062e\u0631\u0648\u062c \u0627\u0632 \u062d\u0633\u0627\u0628",
  "settingsLogOutConfirmTitle": "\u0627\u0632 \u0627\u06cc\u0646 \u062f\u0633\u062a\u06af\u0627\u0647 \u062e\u0627\u0631\u062c \u0645\u06cc\u200c\u0634\u0648\u06cc\u062f\u061f",
  "settingsLogOutConfirmBody": "\u0647\u0631 \u0686\u06cc\u0632\u06cc \u06a9\u0647 \u0627\u06cc\u0646 \u06af\u0648\u0634\u06cc \u0646\u06af\u0647 \u062f\u0627\u0634\u062a\u0647 \u067e\u0627\u06a9 \u0645\u06cc\u200c\u0634\u0648\u062f: \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u060c \u0645\u062e\u0627\u0637\u0628\u0627\u0646\u060c \u0648 \u06a9\u0644\u06cc\u062f\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0631\u0645\u0632\u06af\u0634\u0627\u06cc\u06cc \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f. \u0633\u0631\u0648\u0631 \u0647\u06cc\u0686 \u0646\u0633\u062e\u0647\u200c\u0627\u06cc \u0627\u0632 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647\u0654 \u0634\u0645\u0627 \u0646\u06af\u0647 \u0646\u0645\u06cc\u200c\u062f\u0627\u0631\u062f\u060c \u067e\u0633 \u0628\u0627 \u0648\u0631\u0648\u062f \u062f\u0648\u0628\u0627\u0631\u0647 \u0686\u06cc\u0632\u06cc \u0628\u0627\u0632\u0646\u0645\u06cc\u200c\u06af\u0631\u062f\u062f \u2014 \u062a\u0646\u0647\u0627 \u062f\u0633\u062a\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631\u06cc \u06a9\u0647 \u0647\u0646\u0648\u0632 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u0631\u0627 \u062f\u0627\u0631\u062f \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0622\u0646 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u0628\u0641\u0631\u0633\u062a\u062f. \u0631\u0645\u0632 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0647\u0648\u06cc\u062a \u0634\u0645\u0627 \u0631\u0627 \u0628\u0627\u0632\u0645\u06cc\u200c\u06af\u0631\u062f\u0627\u0646\u062f\u060c \u0647\u0631\u06af\u0632 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627 \u0631\u0627.",
