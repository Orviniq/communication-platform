<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 (API 33) and above gate every non-exempt notification behind
         this runtime permission, and notifications are off by default on a
         fresh install. It is requested at the point of use - the first time a
         message is waiting that cannot be announced - and a refusal is a stated
         outcome, not a retry loop. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Read by the delivery supervisor to know when the operating system says
         there is no network at all, so a cycle is not started against one and a
         held socket is given up rather than believed. It arrives in the merged
         manifest from connectivity_plus either way (ADR-054); it is declared
         here so that every permission in the artifact is stated and justified in
         the file a reviewer reads, rather than only in a package's. Normal
         protection level: granted at install with no prompt, and it reports the
         transport and its capabilities, never an address, an operator or a
         payload. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The message alert channel enables vibration, which is what reaches a
         phone in a pocket or on silent. Normal protection level: it is granted
         at install with no prompt and exposes nothing about the device or its
         owner. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required by JobInfo.Builder.setPersisted(true), which is what makes the
         deferred catch-up survive a restart without this application declaring
         a boot receiver of its own. Normal protection level: granted at install
         with no prompt, and it grants no data, no network and no location. The
         job still cannot run before the first unlock, because the database key
         is credential-encrypted and this application is not direct-boot aware. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sustained delivery only (ADR-051), and nothing runs under either of
         these until the user turns that capability on. Both are normal
         protection level: they are granted at install with no prompt, they
         grant no data, no network and no location, and declaring them changes
         nothing about a build nobody has enabled the capability in. What they
         permit is a foreground service of the `specialUse` type, whose truthful
         justification is the <property> on the service below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required in order to show the system's own battery-optimization
         exemption dialog. Holding it grants nothing by itself: the exemption is
         the user's to give in that dialog and theirs to withdraw afterwards,
         and this application reads the answer back from
         PowerManager.isIgnoringBatteryOptimizations() rather than assuming it.
         Android's own acceptable-use table sanctions asking for exactly this
         case - a chat application that cannot use FCM. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Voice rooms (ADR-077, ADR-078). Dangerous protection level, so nothing
         is granted at install. It is asked for when the user joins a call and
         at no other time - never at start-up and never from another screen
         (CLIENT_CONTRACT.md §N rule 11). flutter_webrtc's getUserMedia asks for
         it on its own when it is missing, so a join has to have asked first. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets a call keep the microphone after the user turns to another screen
         or another application: from Android 14 (API 34) a foreground service
         of the `microphone` type cannot start without it (§N rule 11). Normal
         protection level, granted at install with no prompt, and it opens no
         microphone by itself - RECORD_AUDIO still decides that. The generic
         FOREGROUND_SERVICE it builds on is declared above, for sustained
         delivery. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Arrives from audioswitch, through flutter_webrtc, whether it is written
         here or not, and is declared here for the reason ACCESS_NETWORK_STATE is
         (ADR-054). A call puts the platform into its communication audio mode
         and moves the sound between earpiece, speaker and headset, which are
         changes to global audio settings. Normal protection level, granted at
         install with no prompt; it changes where audio goes and reads nothing. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Refused, not inherited (ADR-078). audioswitch merges in BLUETOOTH for
         Android 11 and below, and nothing on the path flutter_webrtc takes ever
         checks it. flutter_webrtc builds audioswitch's AudioSwitch, which finds
         and routes audio devices through AudioManager; the one class that checks
         a Bluetooth permission belongs to LegacyAudioSwitch, and even that one
         keys on this application's targetSdkVersion, so it would check
         BLUETOOTH_CONNECT instead. The voice design ships no Bluetooth headset
         route; one that needs a Bluetooth permission is a dated record. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The deferred catch-up (ADR-049). A plain service, never a foreground
             one: it shows no notification, holds no connection and asks for no
             exemption. BIND_JOB_SERVICE is what makes the job scheduler the
             only thing that can start it, and exported="false" is what keeps
             every other application off it. -->
        <service
            android:name=".DeferredDeliveryJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Sustained delivery (ADR-051). Off by default and started only by
             this application, after a Dart isolate has read the user's durable
             choice out of the encrypted database; a build nobody enabled it in
             never starts it, shows nothing and holds nothing.

             `specialUse` because holding an authenticated connection to this
             application's own self-hosted server is none of the other declared
             types: `dataSync` would overstate it and is capped at six hours a
             day and forbidden from a boot receiver, `remoteMessaging` means
             device-to-device message continuity, and `systemExempted` is gated
             on roles this application does not have. The subtype property below
             is written to be true, not to be accepted; this artifact is never
             submitted to Google Play, where such values are reviewed. -->
        <service
            android:name=".SustainedDeliveryService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps this application's process out of the cached state so that its authenticated connection to the user's own self-hosted messaging server survives, and end-to-end encrypted messages can be received while the application is not in use. No push transport is reachable in this deployment, so there is no messaging service to be woken by instead. Started only after the user explicitly turns the capability on, and stopped as soon as they turn it off." />
        </service>
        <!-- A call's microphone (CLIENT_CONTRACT.md §N rule 11, ADR-078).
             Started only by this application, from a join, after the user
             granted RECORD_AUDIO and while the activity is visible - the
             platform refuses a `microphone` service otherwise - and stopped
             when the call ends, when the engine holding the call goes away,
             or when the user removes the task. It is never restarted. It holds
             no audio and no connection: it exists so that the call keeps the
             microphone while the user looks at another screen or another
             application, which a while-in-use permission does not otherwise
             allow.

             `microphone` because that is what it keeps, and because it is the
             type the platform defines for "continue microphone capture from
             the background, such as voice recorders or communication apps".
             Unexported, so nothing outside this application can start it. -->
        <service
            android:name=".VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Refused, not inherited (ADR-054). androidx.profileinstaller
             arrives transitively behind androidx.core and the Flutter
             embedding, and its manifest contributes an *exported* receiver with
             four intent filters that this application never asks for. Nothing
             here starts it, nothing here would have declared it, and the
             baseline profile is still written on first run by
             ProfileInstallerInitializer, which calls ProfileInstaller.writeProfile
             directly and never references this receiver. What is lost is the
             shell- and store-triggered profile operations, neither of which
             exists in a privately handed-over artifact. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
