[Unit]
Description=chat backend retention pruning
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=www-data
UMask=0027
WorkingDirectory=/srv/chat/backend
EnvironmentFile=/srv/chat/backend/.env.production
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
# Deletes queued envelopes, attachments and admin audit rows that are past their
# retention window. Ciphertext and metadata only; never a remote-wipe guarantee.
# No token is flushed here, because no token is stored (ADR-0006).
#
# The command holds a PostgreSQL advisory lock for its whole run and declines,
# with exit status 0, when another run already has it. That guard — not this
# unit's state — is what stops the timer's fire from interleaving with a sweep an
# operator started by hand.
ExecStart=/srv/chat/backend/.venv/bin/python manage.py prune

# The other half of that guard, and the reason it is stated rather than left to
# `DefaultTimeoutStartSec`: systemd will not start a second instance of this unit
# while one is active, so a run that never returns holds the timer's every later
# fire behind it, and the distribution default of 90 s would instead kill a large
# sweep partway and mark the unit failed. Fifteen minutes is neither: the largest
# sweep ever measured — 99 962 expired envelopes of 200 000, in batches of a
# thousand — took 5.95 s, so this is two orders of magnitude of headroom, and a
# run that reaches it is blocked rather than busy. A kill costs nothing: every
# batch commits on its own, the advisory lock dies with the backend, and the next
# fire resumes from what is left.
TimeoutStartSec=15min

# The same rule as the serving unit: the sweep opens the database with the same
# credentials and holds the same environment, so a dump of it is the same yield.
LimitCORE=0

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectClock=true
ProtectHostname=true
SystemCallArchitectures=native
ReadWritePaths=/srv/chat/backend/media_root
