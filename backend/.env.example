# Environment for the chat backend.
#
# Development: copy to `.env` and export it into your shell before running
# manage.py or pytest:
#
#     set -a; source .env; set +a
#
# Production: copy to /srv/chat/backend/.env.production (root-owned, mode 0640);
# the systemd units load it via EnvironmentFile. Neither copy is ever committed.
#
# Generate every secret below with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Secrets here are infrastructure secrets. None of them can decrypt any message:
# content keys never reach this server.

# --- Django core ---------------------------------------------------------------
# config.settings.dev for development, config.settings.prod on the VPS.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
# Comma-separated. Must list the real hostname in production.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Path the admin panel is mounted at. Pick something non-obvious in production, and
# change the matching location in ops/nginx/chat.nimashadloo.dev.conf with it.
ADMIN_PATH=admin/
# How long an admin audit row survives. `manage.py prune` deletes the rest. The rows
# name an operator, a UTC day and an object; SECURITY.md lists them in the seizure
# yield.
ADMIN_AUDIT_RETENTION_DAYS=30

# --- PostgreSQL (localhost only) -----------------------------------------------
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Must stay 0. Django's psycopg pool refuses a higher value, and nothing in this
# process fires the request signals that would reap a persistent connection.
DB_CONN_MAX_AGE=0
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=16
DB_POOL_TIMEOUT=10

# --- Redis (localhost only, non-persistent) ------------------------------------
# Production carries the `requirepass` value of ops/redis/redis-chatapp.conf as
# redis://:<password>@127.0.0.1:6379/0; `check --deploy` refuses a URL without one.
REDIS_URL=redis://127.0.0.1:6379/0
# Connect and per-command timeout for every Redis client of the process, so a
# Redis that accepts the connection and then stops answering cannot hold a
# caller for ever. Loopback commands here are sub-millisecond.
REDIS_COMMAND_TIMEOUT_SECONDS=2

# --- Auth ----------------------------------------------------------------------
# At least 32 characters and shared with nothing else; the generator above gives
# 86. `check --deploy` refuses a shorter value or one equal to DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
SESSION_TOKEN_DAYS=30
REGISTER_SCOPE_ACCESS_MIN=10

# --- Request limits ------------------------------------------------------------
# One process on 1 GB of RAM has no headroom for an unbounded body or a request
# that never ends. A request past its deadline answers 503; a body above its cap
# answers 413. The batch cap covers the device and envelope bodies, whose length
# is a list cap times a base64 cap; nginx caps the same value. The attachment
# upload takes the largest attachment bucket (64 MiB) plus the multipart wrapper
# below, and the deadline is the one that covers a 64 MiB body over a slow link.
REQUEST_DEADLINE_SECONDS=15
UPLOAD_DEADLINE_SECONDS=120
BODY_CAP_JSON_BYTES=16384
BODY_CAP_BACKUP_BYTES=2097152
BODY_CAP_BATCH_BYTES=73400320
MULTIPART_OVERHEAD_BYTES=8192

# --- Throttle rates ------------------------------------------------------------
# Counted in Redis, keyed on the account for an authenticated request and on the
# client address otherwise. A throttled route fails closed with 503 when Redis is
# unreachable.
THROTTLE_REGISTER=10/hour
THROTTLE_LOGIN=20/hour
THROTTLE_ACCOUNTS=300/min
THROTTLE_CLAIM=120/min
THROTTLE_ENVELOPES=600/min
THROTTLE_ATTACHMENTS=60/min
THROTTLE_RELAY=60/min

# --- Storage, quotas and retention ---------------------------------------------
# Development falls back to <repo>/media_root when unset; production uses the
# deploy path.
ATTACHMENTS_ROOT=/srv/chat/backend/media_root
# What one account may upload in one UTC day, in bytes (256 MiB). Counted in Redis
# under a key that names the account and the day; an upload past it is refused with
# 413 quota_exceeded. No account carries a lifetime total: nothing on an attachment
# row says who uploaded it.
ATTACH_DAILY_BYTES=268435456
# The free space ATTACHMENTS_ROOT must still have for an upload to be admitted, in
# bytes (2 GiB). Below it every upload answers 503 storage_full. It is the guard on
# the disk itself, which the per-account allowance above does not bound.
ATTACH_MIN_FREE_BYTES=2147483648
ATTACH_TTL_DAYS=30
# Governs only undelivered envelopes (delivery deletes on ack). 7 days bounds a
# seizure's take and is also the window an offline device has to collect its
# mail before it must repair the pairwise sessions whose messages were pruned.
ENVELOPE_TTL_DAYS=7
# The most undelivered bytes one mailbox holds. A send that would push a device
# past it is refused for that device (`full_devices`) until the device drains.
MAILBOX_MAX_BYTES=33554432
MAX_DEVICES_PER_USER=10
# The most records one account's device-list log holds; an append past it is
# refused with 409 devicelog_limit. A client appends one for each device change.
MAX_DEVICELOG_RECORDS=10000

# --- Server --------------------------------------------------------------------
# uvicorn worker processes. One is the design point: 1 vCPU and 1 GB of RAM will
# not hold two, and each worker opens its own Redis publish-and-subscribe
# connection for the gateway's fan-out.
WEB_CONCURRENCY=1

# --- Realtime ------------------------------------------------------------------
WS_MAX_FRAME=524288

# --- Voice relay ---------------------------------------------------------------
# coturn is the only media service (ADR-0021, ops/coturn/turnserver.conf) and
# `POST /api/v1/me/relay` is the only route voice has. A comma-separated list of
# `turn:` URLs; empty turns voice off and the route answers 503 voice_unconfigured,
# so a deployment serves voice by filling this in rather than by default.
TURN_URLS=turn:chat.nimashadloo.dev:3478?transport=udp,turn:chat.nimashadloo.dev:3478?transport=tcp
# Read by ops/coturn/turnserver.conf alone.
TURN_REALM=chat.nimashadloo.dev
# One value in two places: here, and `static-auth-secret` in the coturn file. It is
# infrastructure — it authorizes a relay allocation and can decrypt nothing,
# because SRTP is keyed by DTLS between the two client endpoints. `check --deploy`
# refuses a value under 32 characters once TURN_URLS is set.
TURN_STATIC_AUTH_SECRET=
# How long a minted relay credential stays good, in seconds. Six hours.
RELAY_CREDENTIAL_TTL_SECONDS=21600
